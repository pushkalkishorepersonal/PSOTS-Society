{
  "name": "psots-moderation-bot",
  "version": "2.0.0",
  "description": "Telegram moderation bot for PSOTS Owners Group (Cloudflare Workers)",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ js/ --max-warnings 300",
    "check:arch": "node scripts/check-architecture.js",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "logs": "wrangler tail",
    "migrate:export": "node scripts/export-firestore.js",
    "migrate:import": "node scripts/import-to-d1.js",
    "migrate:import:dry": "node scripts/import-to-d1.js --dry-run",
    "test:d1": "node scripts/test-d1-adapter.js"
  },
  "keywords": [
    "telegram",
    "bot",
    "moderation",
    "psots",
    "cloudflare-workers"
  ],
  "author": "PSOTS",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "vitest": "^1.6.0",
    "wrangler": "^4.81.1"
  },
  "dependencies": {
    "firebase": "^12.12.0",
    "firebase-admin": "^13.8.0"
  }
}
